PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/secure_notes
# Use a long random string in any real deployment: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=12
# set to 1 when running behind a hosting proxy (Render, Railway, nginx...)
TRUST_PROXY=0
# frontend URL(s) allowed by CORS, comma separated
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Used only by `npm run seed` to create the first admin account.
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
