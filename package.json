{
  "name": "secure-notes-api",
  "version": "1.0.0",
  "description": "Secure note-taking REST API with JWT auth, RBAC, MongoDB indexes and aggregations",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4"
  }
}
